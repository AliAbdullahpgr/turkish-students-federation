{
  "name": "msl-pakistan-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "content:sync": "tsx --env-file=.env scripts/sync-static-content.ts",
    "content:clean": "tsx --env-file=.env scripts/remove-placeholder-content.ts",
    "test": "vitest run --exclude \"**/db-crud.test.ts\" --exclude \"**/db-queries.test.ts\" --exclude \"**/seed.test.ts\" --exclude \"**/node_modules/**\"",
    "test:db": "vitest run src/__tests__/db-crud.test.ts src/__tests__/db-queries.test.ts src/__tests__/seed.test.ts",
    "test:e2e": "playwright test",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "db:auth-tables": "tsx --env-file=.env scripts/create-auth-tables.ts"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.3.2",
    "@libsql/client": "^0.17.3",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-md-editor": "^4.1.1",
    "better-auth": "^1.7.5",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.9.0",
    "nanoid": "^5.1.11",
    "next": "^15.5.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.9",
    "swiper": "^12.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
